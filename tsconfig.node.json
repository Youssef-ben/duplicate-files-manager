{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": ["electron.vite.config.*", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/handlers/**/*"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@handlers/*": ["src/handlers/*"],
      "@shared/*": ["src/shared/*"],
      "@main/*": ["src/main/*"],
      "@pkg": ["./package.json"],
      "@resources/*": ["resources/*"]
    }
  }
}
